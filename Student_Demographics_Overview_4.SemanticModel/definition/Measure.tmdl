table Measure
    lineageTag: 2ea89df5-99da-48b6-85d0-03ebb5443ab6

    measure 'Student count' =

            Var A = DISTINCTCOUNT(student[Student ID])
            return A+0 
        lineageTag: d79827a4-71dc-4289-9f55-a3064f5a46a4

    measure 'Tutors count' =

            Var A = DISTINCTCOUNT('tutor'[tutor_id])
            return A+0 
        lineageTag: 3c62607e-d906-4a05-875d-6d22c13feab9

    measure 'Course offered' =

            Var A = DISTINCTCOUNT('course'[Course id])
            return A+0
        lineageTag: 0a10d58f-247f-4236-9a4c-e8275a878d39

    measure 'Avg Attendance %' =

            Var A = AVERAGE(student[Attendance Percentage])
            return A+0 
        lineageTag: 25dcb1ef-91a4-4068-b4b3-cb8b5ffd082b

    measure 'Avg credits %' =

            Var A = AVERAGE(course[credits])
            return A+0 
        lineageTag: 7588ae16-d8a3-47f9-ba4a-c18629071832
    column Column
        dataType: double
        formatString: #,0.00%;-#,0.00%;#,0.00%
        lineageTag: b06e547d-ae89-48ef-9101-a36ed60310f6
        summarizeBy: none
        isNameInferred
        sourceColumn: [Column]

        annotation SummarizationSetBy = User

    partition Measure = calculated
        mode: import
        source = Row("Column", BLANK())

