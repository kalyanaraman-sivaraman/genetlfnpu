table Measure
    lineageTag: 58f8899a-1017-4d03-bd14-9b227d2b7a5d

    measure 'Current %' =

            Var A = INT( VALUE( SUBSTITUTE( [Attendance Percentage], "%", "" ) ) )
            return A+0 
        lineageTag: da98213f-211d-4e65-a8b7-87ee38f13b2d

    measure 'Student count' =

            Var A = DISTINCTCOUNT([Student ID])
            return A+0 
        lineageTag: ec398790-138d-4be7-8396-6dace4284706

    measure 'Tutors count' =

            Var A = DISTINCTCOUNT([tutor_id])
            return A+0 
        lineageTag: 3b101be4-61fc-45f4-b362-b70287a8a160

    measure 'Course offered' =

            Var A = DISTINCTCOUNT([Course id (course)])
            return A+0 
        lineageTag: 3ca7d26e-952a-4470-815c-d960f431e303

    measure 'Avg Attendance %' =

            Var A = AVERAGE([Attendance Percentage - Split 1])
            return A+0 
        lineageTag: c955ca37-002c-4089-8ab6-f07b59536b8c

    measure 'Avg credits' =

            Var A = AVERAGE([credits])
            return A+0 
        lineageTag: 6745c8f9-041f-400c-a3a8-91ea8b2c239e
    column Column
        dataType: double
        formatString: #,0.00%;-#,0.00%;#,0.00%
        lineageTag: b06e547d-ae89-48ef-9101-a36ed60310f6
        summarizeBy: none
        isNameInferred
        sourceColumn: [Column]

        annotation SummarizationSetBy = User

    partition Measure = calculated
        mode: import
        source = Row("Column", BLANK())

    annotation PBI_Id = 35e43472b79c47efb9bf240e6d624b06
    
